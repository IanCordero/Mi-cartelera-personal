rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function propietario(uid) {
      return request.auth != null && request.auth.uid == uid;
    }
    function valido(d, itemId) {
      return d.keys().hasAll(['tmdbId','tipo','titulo','anio','posterPath','estado',
          'calificacionPersonal','comentario','agregadoEn','actualizadoEn'])
        && d.keys().hasOnly(['tmdbId','tipo','titulo','anio','posterPath','estado',
          'calificacionPersonal','comentario','agregadoEn','actualizadoEn'])
        && d.tmdbId is int && d.tmdbId > 0
        && d.tipo in ['movie','tv']
        && itemId == d.tipo + '_' + string(d.tmdbId)
        && d.titulo is string && d.titulo.size() > 0 && d.titulo.size() <= 200
        && d.anio is string && d.anio.matches('^([0-9]{4})?$')
        && (d.posterPath == null || (d.posterPath is string && d.posterPath.size() <= 300))
        && d.estado in ['por_ver','viendo','vista']
        && d.comentario is string && d.comentario.size() <= 500
        && (d.calificacionPersonal == null || (d.estado == 'vista'
          && d.calificacionPersonal is int && d.calificacionPersonal >= 1 && d.calificacionPersonal <= 5))
        && d.agregadoEn is timestamp && d.actualizadoEn is timestamp
        && d.actualizadoEn == request.time;
    }
    match /usuarios/{uid} {
      // La app no necesita crear un perfil. El uid en la ruta basta.
      // Todo perfil y cualquier otra colección quedan denegados por defecto.
      match /mi_lista/{itemId} {
        allow read, delete: if propietario(uid);
        allow create: if propietario(uid) && valido(request.resource.data, itemId)
          && request.resource.data.agregadoEn == request.time
          && request.resource.data.estado == 'por_ver'
          && request.resource.data.calificacionPersonal == null
          && request.resource.data.comentario == '';
        allow update: if propietario(uid) && valido(request.resource.data, itemId)
          && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['estado','calificacionPersonal','comentario','actualizadoEn']);
      }
    }
  }
}
