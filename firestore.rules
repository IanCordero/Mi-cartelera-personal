rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function propietario(uid) {
      return request.auth != null && request.auth.uid == uid;
    }
    // Firestore Rules no tiene every para listas: validar cada posición posible.
    function nombresValidos(v) {
      return v is list && v.size() <= 10
        && (v.size() < 1 || v[0] is string)
        && (v.size() < 2 || v[1] is string)
        && (v.size() < 3 || v[2] is string)
        && (v.size() < 4 || v[3] is string)
        && (v.size() < 5 || v[4] is string)
        && (v.size() < 6 || v[5] is string)
        && (v.size() < 7 || v[6] is string)
        && (v.size() < 8 || v[7] is string)
        && (v.size() < 9 || v[8] is string)
        && (v.size() < 10 || v[9] is string);
    }
    function valido(d, itemId) {
      return d.keys().hasAll(['tmdbId','tipo','titulo','anio','posterPath','estado',
          'calificacionPersonal','comentario','agregadoEn','actualizadoEn'])
        && d.keys().hasOnly(['tmdbId','tipo','titulo','anio','posterPath','estado',
          'calificacionPersonal','comentario','agregadoEn','actualizadoEn',
          'vistaEn','generos','duracionMin','directores'])
        && d.tmdbId is int && d.tmdbId > 0
        && d.tipo in ['movie','tv'] && itemId == d.tipo + '_' + string(d.tmdbId)
        && d.titulo is string && d.titulo.size() > 0 && d.titulo.size() <= 200
        && d.anio is string && d.anio.matches('^([0-9]{4})?$')
        && (d.posterPath == null || (d.posterPath is string && d.posterPath.size() <= 300))
        && d.estado in ['por_ver','viendo','vista']
        && d.comentario is string && d.comentario.size() <= 500
        && (d.calificacionPersonal == null || (d.estado == 'vista'
          && d.calificacionPersonal is int && d.calificacionPersonal >= 1 && d.calificacionPersonal <= 5))
        && d.agregadoEn is timestamp && d.actualizadoEn is timestamp && d.actualizadoEn == request.time
        && (d.get('vistaEn',null) == null || (d.estado == 'vista' && d.vistaEn is timestamp))
        && nombresValidos(d.get('generos',[])) && nombresValidos(d.get('directores',[]))
        && (d.get('duracionMin',null) == null || (d.duracionMin is int && d.duracionMin > 0 && d.duracionMin <= 1000))
        && (d.tipo == 'movie' || (d.get('duracionMin',null) == null && d.get('directores',[]).size() == 0));
    }
    function fechaCorrecta(antes, despues) {
      return despues.estado != 'vista'
        ? despues.get('vistaEn',null) == null
        : antes.estado != 'vista'
          ? despues.get('vistaEn',null) == request.time
          : antes.get('vistaEn',null) != null
            ? despues.get('vistaEn',null) == antes.vistaEn
            : (despues.get('vistaEn',null) == null || despues.vistaEn == antes.actualizadoEn);
    }
    match /usuarios/{uid}/mi_lista/{itemId} {
      allow read, delete: if propietario(uid);
      allow create: if propietario(uid) && valido(request.resource.data,itemId)
        && request.resource.data.keys().hasAll(['vistaEn','generos','duracionMin','directores'])
        && request.resource.data.agregadoEn == request.time
        && request.resource.data.estado == 'por_ver' && request.resource.data.vistaEn == null
        && request.resource.data.calificacionPersonal == null && request.resource.data.comentario == '';
      allow update: if propietario(uid) && valido(request.resource.data,itemId)
        && fechaCorrecta(resource.data,request.resource.data)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'estado','calificacionPersonal','comentario','actualizadoEn','vistaEn','generos','duracionMin','directores']);
    }
  }
}
